# ==============================================================================
# Institute of Trading Tricks LMS — Environment Configuration Template
# ==============================================================================

# Database Connection (MongoDB Atlas Shared Cluster)
# Dedicated LMS Database: itt_lms (MUST NOT be middle_eastern_fries or any other DB)
# Note: Special characters in password (such as @, :, /, ?, #, %) must be URL-encoded (e.g. '@' -> '%40')
# MONGODB_URI="mongodb://muhammadumarhassan987_db_user:VOkQw6BzRAzKMSpC@ac-ujmyefh-shard-00-00.edxwsws.mongodb.net:27017,ac-ujmyefh-shard-00-01.edxwsws.mongodb.net:27017,ac-ujmyefh-shard-00-02.edxwsws.mongodb.net:27017/itt_lms?ssl=true&replicaSet=atlas-t4ku1e-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0"
# Local development default:

#MONGODB_URI="mongodb://localhost:27017/itt_lms"

# NextAuth / Application Origin
# In production on Hostinger: https://tradingtricks.institute
NEXTAUTH_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"

# NextAuth Secret for JWT cookie encryption (min 32 characters, generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-string-in-production"

# AES-256-GCM 32-byte Base64 key for encrypting video IDs at rest
# CRITICAL: If lost, stored video references cannot be decrypted!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VIDEO_ENC_KEY="change-this-to-a-secure-base64-32-byte-key-in-production"

# HMAC Secret for short-lived one-time playback tickets (separate from NextAuth)
# Generate with: openssl rand -base64 32
TICKET_SECRET="change-this-to-a-secure-ticket-secret-in-production"

# Shared secret for Hostinger cron jobs (/api/cron/*)
CRON_SECRET="change-this-to-a-secure-cron-secret-in-production"

# File / Media Storage
# Option A: Local persistent folder outside app deployment directory (Hostinger)
UPLOAD_DIR="./uploads"

# Option B: Cloudinary CDN fallback (optional)
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# YouTube Data API Key (optional — used for auto-fetching video titles and durations)
# YT_API_KEY=""

# SMTP Email Configuration (optional — for student credential delivery)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=465
# SMTP_USER="support@tradingtricks.institute"
# SMTP_PASS="secure_smtp_password"
# SMTP_FROM="Institute of Trading Tricks <support@tradingtricks.institute>"

# EmailJS Cloud Configuration (for Contact Us Form inquiries -> instituteoftradingtricks@gmail.com)
# Setup guide available at: EMAILJS_SETUP_GUIDE.md
NEXT_PUBLIC_EMAILJS_SERVICE_ID="your_emailjs_service_id"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="your_emailjs_template_id"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
